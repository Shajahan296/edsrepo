function shajahan(){

 const a= document.createElement('div');
 a.setAttribute("class","man");
 a.innerHTML = "This is shajahan";
 document.body.appendChild(a);
 
 function shajahan1() {
    const oldDiv = document.getElementById("msg");

    if (oldDiv) {
        oldDiv.remove(); // Remove it
        return;
    }

    const a = document.createElement("div");
    a.id = "msg";
    a.textContent = "This is shajahan";

    document.getElementById("btn").after(a);
}

}
